{
  "name": "mcp-2099-platform",
  "private": true,
  "version": "2099.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.kindcarson.designhistory",
    "productName": "Design History Atlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "@react-three/drei": "^9.121.0",
    "@react-three/fiber": "^8.17.14",
    "clsx": "^2.1.1",
    "gsap": "^3.12.7",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "isomorphic-git": "^1.40.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vercel": "^56.5.0",
    "vite": "^6.1.0"
  }
}
